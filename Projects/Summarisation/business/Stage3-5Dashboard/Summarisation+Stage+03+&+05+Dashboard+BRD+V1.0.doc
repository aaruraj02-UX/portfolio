<td data-local-id=3D"5bcd5042-7835-4a3a-9d69-ff48d1955545" class=3D"conflue=
nceTd">
<p local-id=3D"cc922ac15988">Dashboard widgets and table should load within=
 acceptable Notice IQ reporting performance standards.</p></td>
</tr>
<tr data-local-id=3D"f62cf8ea-70f2-4b04-a20c-99d4ea3641fc">
