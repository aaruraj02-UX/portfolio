<h2 local-id=3D"1beb2a2ca235" id=3D"BusinessRequirementDocument-Tasks-_Toc2=
23984067CommentValidationRules"><span class=3D"confluence-anchor-link" id=
=3D"BusinessRequirementDocument-Tasks-_Toc223984067"><span class=3D"conflue=
nce-anchor-link" id=3D"_Toc223984067"></span></span>Comment Validation Rule=
s</h2>
<div class=3D"table-wrap">
<table data-table-width=3D"1800" data-layout=3D"default" class=3D"confluenc=
eTable">
<tbody>
<tr>
<td data-highlight-colour=3D"#auto" class=3D"confluenceTd">
<p><strong>Requirement ID</strong></p></td>
