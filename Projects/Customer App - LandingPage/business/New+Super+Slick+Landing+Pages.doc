<li local-id=3D"15e3ccdd-3dd5-493c-b6c9-9a9793722b70">
<p local-id=3D"c09b2327c564">Full=E2=80=91screen enforcement explanation pa=
ges</p></li>
<li local-id=3D"1d45b9d1-f567-483f-bd14-6792acdfbf9f">
<p local-id=3D"e08510f2dd5d">Modal=E2=80=91based enforcement information ca=
rds</p></li>
