nceTh">
<p local-id=3D"2ff5c9870286">Definition</p></th>
</tr>
<tr data-local-id=3D"681f216c-a56f-4b88-809a-9abe7430e2b7">
<td data-local-id=3D"7b4f648e-00c2-4a7b-9f1f-44ae1ca34df7" class=3D"conflue=
nceTd">
<p local-id=3D"10a38b45f93c">Fiona</p></td>
<td data-local-id=3D"7df57dc3-87a7-470a-9c6e-140851e14877" class=3D"conflue=
nceTd">
<p local-id=3D"94c97a4fca7a">Internal automation platform used to manage fi=
nancial and operational workflows across Treasury, Payroll, and Finance tea=
ms.</p></td>
</tr>
<tr data-local-id=3D"2c5ad6f0-0578-45a7-a0b0-66cf7fb81a80">
<td data-local-id=3D"bfdd8474-2e31-4020-a6b4-59fae0e794b6" class=3D"conflue=
nceTd">
<p local-id=3D"09a1181a8851">Admin Dashboard</p></td>
<td data-local-id=3D"7687f5f1-669c-4957-a6d0-61a3d8640a9f" class=3D"conflue=
nceTd">
<p local-id=3D"deabb5fa0264">Centralized interface that provides administra=
tors with insights into system usage, workflow performance, and automation =
metrics.</p></td>
</tr>
<tr data-local-id=3D"bde58284-a8e2-4ac6-841d-caafd103b6a1">
<td data-local-id=3D"a1ddb6df-ef9f-41f1-91d0-4e7a00a4e567" class=3D"conflue=
nceTd">
<p local-id=3D"531a0cc93747">KPI (Key Performance Indicator)</p></td>
<td data-local-id=3D"173628e0-b90b-4d1f-a2d9-ccc89f52682f" class=3D"conflue=
nceTd">
<p local-id=3D"5200c637a491">A measurable metric used to evaluate system pe=
rformance, user activity, or process efficiency.</p></td>
</tr>
<tr data-local-id=3D"03f84e4a-db26-4c01-976f-e5a0308577cf">
<td data-local-id=3D"e2f157db-45d2-41de-9e43-7def425fbdf3" class=3D"conflue=
nceTd">
<p local-id=3D"2a5769e74c1c">Active User</p></td>
<td data-local-id=3D"8144f9d8-49f6-4ecc-9d6f-ac1b9c360e97" class=3D"conflue=
nceTd">
<p local-id=3D"961df79cad37">A user who has accessed the Fiona system withi=
n a specified reporting period.</p></td>
</tr>
<tr data-local-id=3D"4ece532c-33b4-44eb-b0d6-45a2113a8ce3">
<td data-local-id=3D"72aa894a-a717-4475-ba85-59c4b56f8bb9" class=3D"conflue=
nceTd">
<p local-id=3D"9beb56113ebf">Workflow</p></td>
<td data-local-id=3D"2b8fb46f-fd16-42b0-b19b-700d27b46316" class=3D"conflue=
nceTd">
<p local-id=3D"8df5bbc53991">A structured process involving request creatio=
n, approval, and completion within Fiona modules.</p></td>
</tr>
<tr data-local-id=3D"8fb447b9-dde5-415a-9b98-58ff133f0414">
<td data-local-id=3D"cac505e0-e0fd-4b13-93ab-0165c77f7b56" class=3D"conflue=
nceTd">
<p local-id=3D"b18cdc0eff14">Bot</p></td>
<td data-local-id=3D"6f43c8c2-f8a7-4cbc-a70e-832068cb509d" class=3D"conflue=
nceTd">
<p local-id=3D"130bee69569d">An automated process (RPA) used to perform rep=
etitive tasks such as file processing or data handling.</p></td>
</tr>
<tr data-local-id=3D"7ac44383-a785-42d4-9f21-ed31503fbd39">
<td data-local-id=3D"2a0afa22-0ff7-4390-ac97-06a2eb1ef158" class=3D"conflue=
nceTd">
<p local-id=3D"2646a444fb0f">Bot Success Rate</p></td>
<td data-local-id=3D"574155e4-63d9-42aa-9b09-b371679bc781" class=3D"conflue=
nceTd">
<p local-id=3D"a0639fcae42f">Percentage of tasks successfully completed by =
a bot without errors.</p></td>
</tr>
<tr data-local-id=3D"ee30e5e5-120f-4957-8b39-45dc8b02bb36">
<td data-local-id=3D"2189eb3f-a66e-4eb6-a6b9-75dbf582e3be" class=3D"conflue=
nceTd">
<p local-id=3D"15f10d1e486c">Bot Failure Rate</p></td>
<td data-local-id=3D"667856ee-7ccc-405f-ae12-7d196e50f0f7" class=3D"conflue=
nceTd">
<p local-id=3D"8c9a90c81e43">Percentage of bot processes that fail and may =
require manual intervention.</p></td>
</tr>
<tr data-local-id=3D"d70b10ef-934d-4857-9815-9a4e7f62bd4c">
<td data-local-id=3D"5212a32c-039c-4697-8dfe-ffa3fae8c183" class=3D"conflue=
nceTd">
<p local-id=3D"e216efafeb82">Manual Intervention</p></td>
<td data-local-id=3D"3f2d393d-b921-4c7a-8462-7ff7138e6309" class=3D"conflue=
