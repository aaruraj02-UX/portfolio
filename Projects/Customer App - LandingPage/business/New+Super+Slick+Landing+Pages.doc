<li local-id=3D"a3bfff3e-c1cd-4ed4-85bc-dff26af6ae09">
<p local-id=3D"51f478cb0a34">Debt type</p></li>
<li local-id=3D"516fdf0d-3acf-4b5c-b9fa-fdb0f16b172a">
<p local-id=3D"806cd96b243e">Case urgency</p></li>
<li local-id=3D"1dc0189b-b20a-402b-9e7b-9d3fb6f475a1">
<p local-id=3D"e8dd93a0f643">Time remaining</p></li>
<li local-id=3D"d76b7667-cfa0-4a00-98f6-a2230d43a287">
<p local-id=3D"ffb36aad8757">Single vs multi=E2=80=91case context</p></li>
</ul>
<p local-id=3D"db2fae586428">No enforcement messaging appears pre=E2=80=91I=
D&amp;V.</p>
